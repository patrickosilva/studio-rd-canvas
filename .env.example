# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=

# Notificações de agendamento por e-mail.
# Sem essas variáveis configuradas, o envio de e-mail fica desativado
# silenciosamente e o restante da aplicação continua funcionando normalmente.
#
# Endereço da barbearia que recebe as notificações (destinatário fixo,
# não é escolhido pelo cliente). Se não definido, usa
# studiordbarber00@gmail.com como padrão.
NOTIFICATION_EMAIL=studiordbarber00@gmail.com

# Credenciais SMTP usadas para enviar as notificações. Exemplo para Gmail:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<conta gmail>,
# SMTP_PASSWORD=<App Password de 16 dígitos gerado na conta Google>.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Endereço de remetente usado no campo "From" dos e-mails (novo agendamento,
# cancelamento, reagendamento, confirmação, recusa e lembrete). Opcional —
# se não definido, usa o valor de SMTP_USER.
EMAIL_FROM=


# ------------------------------------------------------------
# V2.4 - Mercado Pago / pagamentos
# ------------------------------------------------------------
# OAuth da conta Mercado Pago da barbearia. A conta conectada sera
# a recebedora dos pagamentos processados pela plataforma.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=

# Exemplo local:
# http://localhost:3000/api/pagamentos/mercado-pago/oauth/callback
MERCADO_PAGO_REDIRECT_URI=

# Assinatura secreta configurada na area de Webhooks do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=

# Chave de 32 bytes em Base64 usada SOMENTE pelo servidor para
# criptografar access_token/refresh_token antes de salvar no banco.
# Gere localmente com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_TOKEN_ENCRYPTION_KEY=


# Studio RD V2.0 - Integracoes externas
# Gere uma chave de 32 bytes em Base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_SECRET_ENCRYPTION_KEY=

# Aplicacao Meta da plataforma
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
