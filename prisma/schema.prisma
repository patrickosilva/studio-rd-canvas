// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id           Int      @id @default(autoincrement())
  nome         String
  telefone     String   @unique
  email        String?  @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum PapelUsuario {
  CLIENTE
  FUNCIONARIO
  DONO
}

enum StatusAgendamento {
  SOLICITADO
  CONFIRMADO
  RECUSADO
  CANCELADO_CLIENTE
  CANCELADO_FUNCIONARIO
  CONCLUIDO
  FALTOU
}

model Usuario {
  id        String       @id @default(cuid())
  nome      String
  email     String       @unique
  telefone  String?      @unique
  senhaHash String
  papel     PapelUsuario @default(CLIENTE)

  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sessoes      Sessao[]
  profissional Profissional?
  assinaturas  AssinaturaCliente[] @relation("AssinaturasCliente")
  agendamentos Agendamento[]       @relation("AgendamentosCliente")
}

model Servico {
  id             String        @id @default(cuid())
  nome           String        @unique
  descricao      String?
  duracaoMinutos Int
  precoCentavos  Int
  ativo          Boolean       @default(true)
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt
  agendamentos   Agendamento[]

  @@index([ativo])
}

model Profissional {
  id           String   @id @default(cuid())
  usuarioId    String?  @unique
  nome         String
  telefone     String?
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario      Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  agendamentos Agendamento[]
  bloqueios    BloqueioAgenda[]

  @@index([ativo])
}

model Sessao {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  ASSINATURA
  CORTESIA
  OUTRO
}

enum StatusAssinatura {
  ATIVA
  PAUSADA
  CANCELADA
  EXPIRADA
}

model Agendamento {
  id String @id @default(cuid())

  clienteId      String
  profissionalId String
  servicoId      String
  usoAssinatura  UsoAssinatura?

  inicio DateTime
  fim    DateTime

  status StatusAgendamento @default(SOLICITADO)

  observacaoCliente   String?
  observacaoInterna   String?
  motivoRecusa        String?
  motivoCancelamento  String?
  canceladoEm         DateTime?
  formaPagamento      FormaPagamento?
  valorPagoCentavos   Int?
  pagoEm              DateTime?
  observacaoPagamento String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente      Usuario      @relation("AgendamentosCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  servico      Servico      @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([profissionalId])
  @@index([servicoId])
  @@index([status])
  @@index([formaPagamento])
  @@index([inicio])
  @@index([profissionalId, inicio])
}

model BloqueioAgenda {
  id String @id @default(cuid())

  profissionalId String?
  inicio         DateTime
  fim            DateTime

  motivo String?
  ativo  Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId])
  @@index([inicio])
  @@index([fim])
  @@index([ativo])
  @@index([profissionalId, inicio])
}

model PlanoAssinatura {
  id             String  @id @default(cuid())
  nome           String  @unique
  descricao      String?
  precoCentavos  Int
  cortesPorCiclo Int
  duracaoDias    Int     @default(30)
  ativo          Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  assinaturas AssinaturaCliente[]

  @@index([ativo])
}

model AssinaturaCliente {
  id String @id @default(cuid())

  clienteId String
  planoId   String

  status StatusAssinatura @default(ATIVA)

  inicio         DateTime @default(now())
  vigenciaInicio DateTime
  vigenciaFim    DateTime

  saldoCortes           Int
  renovaAutomaticamente Boolean @default(false)

  observacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente Usuario         @relation("AssinaturasCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  plano   PlanoAssinatura @relation(fields: [planoId], references: [id], onDelete: Restrict)

  usos       UsoAssinatura[]
  pagamentos PagamentoAssinatura[]

  @@index([clienteId])
  @@index([planoId])
  @@index([status])
  @@index([vigenciaFim])
}

model UsoAssinatura {
  id String @id @default(cuid())

  assinaturaId  String
  agendamentoId String @unique

  quantidadeCortes Int @default(1)

  criadoEm DateTime @default(now())

  assinatura  AssinaturaCliente @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  agendamento Agendamento       @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([assinaturaId])
}

model PagamentoAssinatura {
  id String @id @default(cuid())

  assinaturaId   String
  formaPagamento FormaPagamento
  valorCentavos  Int
  pagoEm         DateTime       @default(now())
  observacao     String?

  criadoEm DateTime @default(now())

  assinatura AssinaturaCliente @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  @@index([assinaturaId])
  @@index([formaPagamento])
  @@index([pagoEm])
}
