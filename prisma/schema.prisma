// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id           Int      @id @default(autoincrement())
  nome         String
  telefone     String   @unique
  email        String?  @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum PapelUsuario {
  CLIENTE
  FUNCIONARIO
  DONO
}

enum StatusAgendamento {
  SOLICITADO
  CONFIRMADO
  RECUSADO
  CANCELADO_CLIENTE
  CANCELADO_FUNCIONARIO
  CONCLUIDO
  FALTOU
}

model Usuario {
  id        String       @id @default(cuid())
  nome      String
  email     String       @unique
  telefone  String?
  senhaHash String?
  papel     PapelUsuario @default(CLIENTE)

  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  termosVersaoAceita     String?
  termosAceitosEm        DateTime?
  sessoes                Sessao[]
  profissional           Profissional?
  assinaturas            AssinaturaCliente[]     @relation("AssinaturasCliente")
  agendamentos           Agendamento[]           @relation("AgendamentosCliente")
  notificacoes           Notificacao[]
  tokensRedefinicaoSenha TokenRedefinicaoSenha[]
  contasOAuth            ContaOAuth[]
  usosCupons             UsoCupom[]

  @@index([telefone])
}

model Servico {
  id             String         @id @default(cuid())
  nome           String         @unique
  descricao      String?
  duracaoMinutos Int
  precoCentavos  Int
  ativo          Boolean        @default(true)
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt
  agendamentos   Agendamento[]
  cupons         CupomServico[]

  @@index([ativo])
}

model Profissional {
  id           String   @id @default(cuid())
  usuarioId    String?  @unique
  nome         String
  telefone     String?
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario      Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  agendamentos Agendamento[]
  bloqueios    BloqueioAgenda[]

  @@index([ativo])
}

enum ProvedorOAuth {
  GOOGLE
}

model ContaOAuth {
  id String @id @default(cuid())

  usuarioId      String
  provedor       ProvedorOAuth
  providerUserId String
  emailNoVinculo String?
  ultimoLoginEm  DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedor, providerUserId])
  @@unique([usuarioId, provedor])
  @@index([usuarioId])
}

model Sessao {
  id                String   @id @default(cuid())
  tokenHash         String   @unique
  usuarioId         String
  expiraEm          DateTime
  persistente       Boolean  @default(false)
  ultimaAtividadeEm DateTime @default(now())
  userAgent         String?
  criadoEm          DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  ASSINATURA
  CORTESIA
  OUTRO
}

enum ProvedorIntegracao {
  INTER
  META
}

enum StatusIntegracao {
  DESCONECTADA
  CONFIGURANDO
  CONECTADA
  ERRO
}

enum ProvedorPagamento {
  INTER
  MANUAL
  MERCADO_PAGO
}

enum StatusConexaoPagamento {
  DESCONECTADA
  PENDENTE
  CONECTADA
  ERRO
}

enum StatusAssinatura {
  ATIVA
  PAUSADA
  CANCELADA
  EXPIRADA
}

enum TipoDescontoCupom {
  PERCENTUAL
  VALOR_FIXO
}

model Agendamento {
  id String @id @default(cuid())

  clienteId      String
  profissionalId String
  servicoId      String
  usoAssinatura  UsoAssinatura?

  inicio DateTime
  fim    DateTime

  status StatusAgendamento @default(SOLICITADO)

  observacaoCliente   String?
  observacaoInterna   String?
  motivoRecusa        String?
  motivoCancelamento  String?
  canceladoEm         DateTime?
  formaPagamento      FormaPagamento?
  valorPagoCentavos   Int?
  pagoEm              DateTime?
  observacaoPagamento String?

  reminderSentAt DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente      Usuario      @relation("AgendamentosCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  servico      Servico      @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  usoCupom     UsoCupom?

  precoOriginalCentavos Int?
  descontoCupomCentavos Int?
  valorFinalCentavos    Int?
  cupomCodigo           String?

  @@index([clienteId])
  @@index([clienteId, inicio])
  @@index([profissionalId])
  @@index([servicoId])
  @@index([status])
  @@index([formaPagamento])
  @@index([inicio])
  @@index([profissionalId, inicio])
  @@index([status, reminderSentAt, inicio])
  @@index([cupomCodigo])
}

model BloqueioAgenda {
  id String @id @default(cuid())

  profissionalId String?
  inicio         DateTime
  fim            DateTime

  motivo String?
  ativo  Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId])
  @@index([inicio])
  @@index([fim])
  @@index([ativo])
  @@index([profissionalId, inicio])
}

model PlanoAssinatura {
  id             String  @id @default(cuid())
  nome           String  @unique
  descricao      String?
  precoCentavos  Int
  cortesPorCiclo Int
  duracaoDias    Int     @default(30)
  ativo          Boolean @default(true)

  // ID equivalente no gateway, caso um plano remoto seja criado no futuro.
  providerPlanId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  assinaturas AssinaturaCliente[]

  @@index([ativo])
}

model AssinaturaCliente {
  id String @id @default(cuid())

  clienteId String
  planoId   String

  status StatusAssinatura @default(ATIVA)

  inicio         DateTime @default(now())
  vigenciaInicio DateTime
  vigenciaFim    DateTime

  saldoCortes           Int
  renovaAutomaticamente Boolean @default(false)

  // A assinatura continua sendo dominio do Studio RD.
  // Estes campos apenas ligam o registro ao provedor financeiro.
  provedorPagamento      ProvedorPagamento @default(MANUAL)
  providerCustomerId     String?
  providerSubscriptionId String?           @unique
  proximaCobrancaEm      DateTime?
  cancelarAoFimDoCiclo   Boolean           @default(false)

  // Basis points: 1000 = 10%. Fica zerado enquanto a comissao estiver desligada.
  percentualComissaoBps Int @default(0)

  observacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente Usuario         @relation("AssinaturasCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  plano   PlanoAssinatura @relation(fields: [planoId], references: [id], onDelete: Restrict)

  usos       UsoAssinatura[]
  pagamentos PagamentoAssinatura[]

  @@index([clienteId])
  @@index([planoId])
  @@index([status])
  @@index([vigenciaFim])
}

model UsoAssinatura {
  id String @id @default(cuid())

  assinaturaId  String
  agendamentoId String @unique

  quantidadeCortes Int @default(1)

  criadoEm DateTime @default(now())

  assinatura  AssinaturaCliente @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  agendamento Agendamento       @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([assinaturaId])
}

model PagamentoAssinatura {
  id String @id @default(cuid())

  assinaturaId   String
  formaPagamento FormaPagamento
  valorCentavos  Int
  pagoEm         DateTime       @default(now())
  observacao     String?

  provedorPagamento ProvedorPagamento @default(MANUAL)
  providerPaymentId String?           @unique
  providerStatus    String?

  taxaGatewayCentavos           Int?
  comissaoPlataformaCentavos    Int  @default(0)
  valorLiquidoBarbeariaCentavos Int?

  criadoEm DateTime @default(now())

  assinatura AssinaturaCliente @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  @@index([assinaturaId])
  @@index([formaPagamento])
  @@index([pagoEm])
}

model ContaRecebedoraPagamento {
  id String @id @default(cuid())

  // A aplicacao atual possui uma unica barbearia.
  // A chave permite evoluir depois para multiplas unidades sem acoplar o gateway.
  chave String @unique @default("STUDIO_RD")

  provedor ProvedorPagamento      @default(MERCADO_PAGO)
  status   StatusConexaoPagamento @default(DESCONECTADA)

  // Identificadores recebidos do Mercado Pago/OAuth.
  providerUserId    String? @unique
  providerAccountId String?

  // Nunca salvar tokens OAuth em texto puro.
  accessTokenCriptografado  String?   @db.Text
  refreshTokenCriptografado String?   @db.Text
  tokenExpiraEm             DateTime?

  conectadoEm    DateTime?
  desconectadoEm DateTime?
  ultimoErro     String?   @db.Text

  // Comissao preparada, mas DESLIGADA por padrao.
  comissaoAtiva         Boolean @default(false)
  percentualComissaoBps Int     @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([provedor, status])
}

model IntegracaoExterna {
  id       String             @id @default(cuid())
  provedor ProvedorIntegracao @unique
  status   StatusIntegracao   @default(DESCONECTADA)

  nomeConta            String?
  identificadorExterno String?
  configuracaoPublica  Json?
  segredoCriptografado String? @db.Text

  conectadoEm  DateTime?
  verificadoEm DateTime?
  ultimoErro   String?   @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
}

model EventoWebhookPagamento {
  id String @id @default(cuid())

  provedor           ProvedorPagamento
  providerEventId    String
  tipo               String
  providerResourceId String?

  // Hash para auditoria sem precisar duplicar payload sensivel.
  payloadHash String?

  status       String    @default("RECEBIDO")
  recebidoEm   DateTime  @default(now())
  processadoEm DateTime?
  erro         String?   @db.Text

  @@unique([provedor, providerEventId])
  @@index([provedor, tipo, recebidoEm])
  @@index([status, recebidoEm])
}

model Notificacao {
  id        String @id @default(cuid())
  usuarioId String

  titulo   String
  mensagem String
  link     String?
  tipo     String  @default("AGENDAMENTO")

  lida Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([lida])
  @@index([criadoEm])
  @@index([usuarioId, lida])
}

model TokenRedefinicaoSenha {
  id        String @id @default(cuid())
  usuarioId String

  tokenHash String   @unique
  usado     Boolean  @default(false)
  expiraEm  DateTime

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario                 Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  resendEmailId           String?   @unique
  resendMessageId         String?
  emailStatus             String?
  emailStatusAtualizadoEm DateTime?

  @@index([usuarioId])
  @@index([expiraEm])
  @@index([usado])
}

model EventoSeguranca {
  id String @id @default(cuid())

  tipo      String
  chaveHash String?
  sucesso   Boolean?
  rota      String?

  criadoEm DateTime @default(now())

  @@index([tipo, chaveHash, criadoEm])
  @@index([tipo, criadoEm])
  @@index([criadoEm])
}

model EventoWebhookResend {
  id String @id @default(cuid())

  eventoId      String  @unique
  tipo          String
  resendEmailId String?

  recebidoEm DateTime @default(now())

  @@index([resendEmailId])
  @@index([tipo, recebidoEm])
  @@index([recebidoEm])
}

model Cupom {
  id String @id @default(cuid())

  codigo    String  @unique
  descricao String?
  campanha  String?

  tipo                   TipoDescontoCupom
  percentualDesconto     Int?
  valorDescontoCentavos  Int?
  limiteDescontoCentavos Int?
  valorMinimoCentavos    Int?

  inicioEm DateTime?
  fimEm    DateTime?

  limiteUsos       Int?
  limitePorCliente Int?

  publico                PublicoCupom @default(TODOS)
  quantidadeAtendimentos Int?
  diasSemAtendimento     Int?

  aplicaTodosServicos     Boolean @default(true)
  visivelParaClientes     Boolean @default(true)
  destaque                Boolean @default(false)
  combinavelComAssinatura Boolean @default(false)
  ativo                   Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  servicos CupomServico[]
  usos     UsoCupom[]

  @@index([ativo])
  @@index([inicioEm])
  @@index([fimEm])
  @@index([ativo, fimEm])
  @@index([visivelParaClientes, ativo])
  @@index([publico])
}

model CupomServico {
  cupomId   String
  servicoId String

  cupom   Cupom   @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@id([cupomId, servicoId])
  @@index([servicoId])
}

enum PublicoCupom {
  TODOS
  PRIMEIRO_ATENDIMENTO
  ATE_X_ATENDIMENTOS
  MINIMO_X_ATENDIMENTOS
  SEM_ATENDIMENTO_HA_X_DIAS
  ASSINANTE_ATIVO
}

model UsoCupom {
  id String @id @default(cuid())

  cupomId       String
  clienteId     String
  agendamentoId String? @unique

  codigoAplicado   String
  descontoCentavos Int
  criadoEm         DateTime @default(now())

  cupom       Cupom        @relation(fields: [cupomId], references: [id], onDelete: Restrict)
  cliente     Usuario      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)

  precoOriginalCentavos Int?
  valorFinalCentavos    Int?

  @@index([cupomId])
  @@index([clienteId])
  @@index([cupomId, clienteId])
  @@index([criadoEm])
}
